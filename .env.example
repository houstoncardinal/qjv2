# Server-only secrets for the Qureshi Circle rewards sync + points redemption
# (src/routes/api.webhooks.orders-paid.ts, src/routes/api.rewards.redeem.ts).
# Never prefix these with VITE_ — that would bundle them into the client-side
# JS. Set the real values in your hosting platform's environment/secrets
# settings, not in a committed file.

# Admin API access token from a custom app in Shopify Admin
# (Settings > Apps and sales channels > Develop apps), with these
# Admin API scopes granted:
#   read_customers, write_customers  — read spend, write points/tier metafields
#   write_discounts                  — create redemption discount codes
SHOPIFY_ADMIN_API_TOKEN=

# Webhook signing secret shown on Settings > Notifications > Webhooks
# in Shopify Admin, used to verify incoming webhook requests are really
# from Shopify (X-Shopify-Hmac-Sha256 header).
SHOPIFY_WEBHOOK_SECRET=
